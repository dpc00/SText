{
  "_comment": "Claude Code / HTTP agents: type=http to 9511. Grok rejects http:// HTTP hooks (SSRF https-only) — use ~/.grok/hooks/ai-log.json command → ai_log_hook_forward.py.",
  "hooks": {
    "UserPromptSubmit":     [{"hooks": [{"type": "http", "url": "http://10.0.0.56:9511/event", "timeout": 5}]}],
    "PreToolUse":           [{"matcher": ".*", "hooks": [{"type": "http", "url": "http://10.0.0.56:9511/event", "timeout": 5}]}],
    "PostToolUse":          [{"matcher": ".*", "hooks": [{"type": "http", "url": "http://10.0.0.56:9511/event", "timeout": 5}]}],
    "PostToolUseFailure":   [{"matcher": ".*", "hooks": [{"type": "http", "url": "http://10.0.0.56:9511/event", "timeout": 5}]}],
    "Stop":                 [{"hooks": [{"type": "http", "url": "http://10.0.0.56:9511/event", "timeout": 5}]}],
    "SubagentStart":        [{"hooks": [{"type": "http", "url": "http://10.0.0.56:9511/event", "timeout": 5}]}],
    "SubagentStop":         [{"hooks": [{"type": "http", "url": "http://10.0.0.56:9511/event", "timeout": 5}]}],
    "Notification":         [{"hooks": [{"type": "http", "url": "http://10.0.0.56:9511/event", "timeout": 5}]}],
    "SessionEnd":           [{"hooks": [{"type": "http", "url": "http://10.0.0.56:9511/event", "timeout": 5}]}]
  }
}
