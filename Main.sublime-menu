[
    {
        "id": "tools",
        "children":
        [
            {
                "caption": "Ai Terminal",
                "mnemonic": "A",
                "id": "ai-terminal",
                "children":
                [
                    {
                        "caption": "Launch Agent\u2026",
                        "command": "ai_terminal_launcher"
                    },
                    {
                        "caption": "Recent Sessions\u2026",
                        "command": "ai_terminal_recent_sessions"
                    },
                    { "caption": "-" },
                    {
                        "caption": "Open Profile\u2026",
                        "command": "ai_terminal_select_profile"
                    },
                    {
                        "caption": "Default Profile",
                        "command": "ai_terminal_open_here"
                    },
                    {
                        "caption": "Refresh Usage & Quota",
                        "command": "ai_terminal_refresh_usage"
                    },
                    { "caption": "-" },
                    {
                        "caption": "Shells",
                        "children":
                        [
                            {
                                "command": "ai_terminal_open_here",
                                "args": { "profile": "Bash" }
                            },
                            {
                                "command": "ai_terminal_open_here",
                                "args": { "profile": "PowerShell" }
                            },
                            {
                                "command": "ai_terminal_open_here",
                                "args": { "profile": "Dos Console" }
                            },
                            {
                                "command": "ai_terminal_open_here",
                                "args": { "profile": "WSL Bash" }
                            }
                        ]
                    },
                    {
                        "caption": "Claude",
                        "children":
                        [
                            {
                                "command": "ai_terminal_open_here",
                                "args": { "profile": "Claude" }
                            },
                            {
                                "command": "ai_terminal_open_here",
                                "args": { "profile": "Claude --chrome" }
                            },
                            {
                                "command": "ai_terminal_open_here",
                                "args": { "profile": "Claude →⇢⇨ Ollama" }
                            },
                            {
                                "command": "ai_terminal_open_here",
                                "args": { "profile": "Claude →⇢⇨ Ollama --chrome" }
                            }
                        ]
                    },
                    {
                        "caption": "OpenCode",
                        "children":
                        [
                            {
                                "command": "ai_terminal_open_here",
                                "args": { "profile": "OpenCode" }
                            },
                            {
                                "command": "ai_terminal_open_here",
                                "args": { "profile": "OpenCode --mini" }
                            },
                            {
                                "command": "ai_terminal_open_here",
                                "args": { "profile": "OpenCode →⇢⇨ Ollama" }
                            },
                            {
                                "command": "ai_terminal_open_here",
                                "args": { "profile": "OpenCode →⇢⇨ Ollama --mini" }
                            }
                        ]
                    },
                    {
                        "caption": "Codex",
                        "children":
                        [
                            {
                                "command": "ai_terminal_open_here",
                                "args": { "profile": "Codex" }
                            },
                            {
                                "command": "ai_terminal_open_here",
                                "args": { "profile": "Codex →⇢⇨ Ollama" }
                            }
                        ]
                    },
                    {
                        "command": "ai_terminal_open_here",
                        "args": { "profile": "Antigravity" }
                    },
                    {
                        "command": "ai_terminal_open_here",
                        "args": { "profile": "Gemini" }
                    },
                    {
                        "command": "ai_terminal_open_here",
                        "args": { "profile": "Grok Build" }
                    },
                    {
                        "command": "ai_terminal_open_here",
                        "args": { "profile": "Junie" }
                    },
                    {
                        "command": "ai_terminal_open_here",
                        "args": { "profile": "Kimi" }
                    },
                    {
                        "command": "ai_terminal_open_here",
                        "args": { "profile": "Mimo" }
                    },
                    {
                        "command": "ai_terminal_open_here",
                        "args": { "profile": "OpenClaw" }
                    },
                    {
                        "command": "ai_terminal_open_here",
                        "args": { "profile": "OpenClaw →⇢⇨ Ollama" }
                    },
                    {
                        "command": "ai_terminal_open_here",
                        "args": { "profile": "Qwen" }
                    },
                    {
                        "command": "ai_terminal_open_here",
                        "args": { "profile": "Qwen →⇢⇨ Ollama" }
                    },
                    {
                        "command": "ai_terminal_open_here",
                        "args": { "profile": "Vibe" }
                    },
                    {
                        "command": "ai_terminal_open_here",
                        "args": { "profile": "Pybackup Textual TUI" }
                    },
                    {
                        "command": "ai_terminal_open_here",
                        "args": { "profile": "Testing Agent" }
                    },
                    { "caption": "-" },
                    {
                        "caption": "Utilities",
                        "children":
                        [
                            { "caption": "Trim Ai Buffer Now", "command": "ai_trim_now" },
                            { "caption": "Export Ai Buffer...", "command": "ai_dump_buffer" },
                            { "caption": "Nuke Ai Terminal", "command": "ai_terminal_nuke" },
                            { "caption": "Screenshot at Scroll", "command": "ai_capture_scroll_position" },
                            { "caption": "-" },
                            { "caption": "Open Terminus+Ai Here", "command": "open_ai_terminus_here" },
                            { "caption": "Open Terminus+Ai in Editor", "command": "open_ai_terminus_in_editor" }
                        ]
                    }
                ]
            },
            { "caption": "-" },
            {
                "caption": "PyBackup Flask App",
                "command": "pb_flask_launcher"
            },
            {
                "caption": "PyBackup Flask App (Silent)",
                "command": "pb_flask_silent"
            },
            {
                "caption": "PyBackup Textual TUI",
                "command": "pb_tui_launcher"
            }
        ]
    }
]
