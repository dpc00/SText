[
	// ai_terminal: bare trackpad / mouse-wheel must not pan the ST view.
	// Default (Windows).sublime-mousemap leaves scroll_up/scroll_down unbound
	// so the core pans the buffer — that breaks fullscreen TUIs (one 6px dip
	// then silence). Route them through ai_terminal_trackpad_scroll, which
	// forwards to the PTY on terminal views and falls through to scroll_lines
	// everywhere else.
	{
		"button": "scroll_up",
		"command": "ai_terminal_trackpad_scroll",
		"args": { "direction": "up", "amount": 3.0 }
	},
	{
		"button": "scroll_down",
		"command": "ai_terminal_trackpad_scroll",
		"args": { "direction": "down", "amount": 3.0 }
	}
]
