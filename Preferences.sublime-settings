{
	"draw_minimap_border": true,
	"file_exclude_patterns": [
		"*.pyc",
		"*.pyo",
		"*.obj",
		"*.o",
		"*.a",
		"*.lib",
		"*.so",
		"*.dylib",
		"*.ncb",
		"*.sdf",
		"*.suo",
		"*.pdb",
		"*.idb",
		".DS_Store",
		".directory",
		"desktop.ini",
		"*.class",
		"*.psd"
	],
	"ignored_packages": [
		"Vintage",
	],
	// CrossDevice holds Windows Phone Link shortcuts to the phone's storage
	// (moto g - 2025). When the phone isn't actively connected, ST's sidebar
	// scanner walking into it throws a failure notification per unreachable
	// path -- 30+ on startup with 'donal' in the sidebar. Skip it entirely.
	"folder_exclude_patterns": [
		"CrossDevice",
	],
	"font_size": 12.75,
	"index_files": false,
	"update_channel": "dev",
}
